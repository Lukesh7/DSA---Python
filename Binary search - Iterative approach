#binary search (iterative approach)

def binary_search(arr,target):
    left = 0 #start of list
    right = len(arr) - 1  #end of list
    
    while left <= right:  #to keep searching
        mid = (left + right) //2  #middle 
        
        if arr[mid] == target:
            return mid
        elif arr[mid] < target :
            left = mid +1  #go right
        else:
            right = mid -1 #go left
            
    return -1 #if loop ends 

nums = [1,2,3,5,7,9,11]        
print(binary_search(nums , 9))  #index - 5
