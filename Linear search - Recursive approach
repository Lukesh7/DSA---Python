# linear search - recursive approach

def linear_search_recursive(arr, target,index = 0):
    
    if index == len(arr):
        return -1
        
    if arr[index] == target:
        return index
        
    return linear_search_recursive(arr,target,index +1)
    
#arr
nums = [1,4,6,3,2,0,9] #ind = 0 1 2 3 4 5 6

