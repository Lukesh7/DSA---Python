#Search a number in list given by user.

def search(arr,target):
    for i in range(len(arr)):
        if arr[i] == target :
            return i
    return -1

list = [5,10,15,20,25,30]  
print(list)
num = int(input("Enter a number to search in the given list : "))

result = (search(list ,num))

print(f"The number is in index of {result}")
