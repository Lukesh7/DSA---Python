#prefix sum

def prefix_sum(arr):
    prefix = [0] * len(arr) #creates an empty list 
    
    prefix[0] = arr[0] #first value is same
    
    for i in range(1, len(arr)):
        #current prefix = previous prefix + current element
        prefix[i] = prefix[i-1] + arr[i]
    
    return prefix
    
arr = [1,2,3,4]
print(prefix_sum(arr))
