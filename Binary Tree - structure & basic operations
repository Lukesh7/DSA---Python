# Tree

#node structure
class Node:
    def __init__(self, val):
        self.data = val
        self.left = None
        self.right = None
        
#creating a tree

root = Node(10)
root.left = Node(20)   
root.right = Node(30) 
#root.left.left = Node(40)
#root.left.right = Node(50)


# Tree Traversal
#           10
#         /      \
#     20         30 

# In order  (L - root - R)

def inorder(root):
    if root:
        inorder(root.left)
        print(root.data)
        inorder(root.right)
        
# Pre order (root - L - R)
def preorder(root):
    if root:
        print(root.data)
        preorder(root.left)
        preorder(root.right)
        
# Post order (L - R - root)
def postorder(root):
    if root:
        postorder(root.left)
        postorder(root.right)
        print(root.data)                  
               
inorder(root) #20 10 30
preorder(root) #10 20 30
postorder(root) #20 30 10 

# Insertion 

def insert(root, val):
        if not root:
                return Node(val)
                
        if val < root.data:
                root.left = insert(root.left, val)  
        else :
                root.right = insert(root.right, val)
        return root
        
insert(root, 40)
insert(root, 50)
print("Inorder after Insertion")
inorder(root) #20 10 30 40 50

print("Pre order after insertion")
preorder(root) #10 20 30 40 50

print("Post order after Insertion")
postorder(root) #20 50 40 30 10

#Search in binary tree
#Left < Root < Right

def search(root, val):
    if not root: #if tree is empty
        return False
    
    if root.data == val: #if val is matched to curr value
        return True
    
    if val < root.data: #if val is smaller then search in left subtree
        return search(root.left, val)
    else:
        return search(root.right, val)#else search right
        
print(search(root, 5)) # False
print(search(root, 30)) # True        
